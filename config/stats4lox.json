{
   "stats4lox" : {
      "s4ltmp" : "/dev/shm/s4ltmp"
   },
   "influx" : {
      "db_storage" : "",
      "influxurl" : "https://localhost:8086",
      "influxbasicauth" : "true",
      "influxskiptlsverify" : "true",
      "influxdatabase" : "stats4lox"
   },
   "telegraf": {
      "unixsocket": "/tmp/telegraf.sock",
      "internal_statfiles": "/tmp/telegraf_internals*.out"
   },
   "grafana": {
      "port": 3000
   },
   "loxone": {
      "active": "True",
      "mqttlive_basetopic": "s4l/mqttlive"
   },
   "miniserver": {
      "measurement" : "stats_miniserver",
      "interval": 900,
      "active": "True",
      "metrics": [
         "sys_cpu",
         "sys_heap",
         "sys_numtasks",
         "sys_temperature",
         "sys_temperature_stm32",
         "sys_check",
         "sps_state",
         "bus_packetssent",
         "bus_packetsreceived",
         "bus_receiveerrors",
         "bus_frameerrors",
         "bus_overruns",
         "bus_parityerrors"
      ]
   },
   "loxberry": {
      "measurement" : "stats_loxberry",
      "interval": 900,
      "active": "False"
   }
}
