#!/usr/bin/perl

#############################################################################
# LoxBerry plugin healthcheck for Stats4Lox
#############################################################################
# Found by the core on its own: sbin/healthcheck.pl walks the installed plugins
# and picks up every executable named "healthcheck" in <plugin>/bin. No
# registration anywhere. Called as "healthcheck check" or "healthcheck title",
# and answers with JSON on stdout:
#
#   { "desc": "...", "status": 5, "result": "..." }
#
# status: 3 ERROR, 4 WARNING, 5 OK, 6 INFO - and the WORST, meaning the lowest,
# is the one that counts. That is why setstatus() below keeps the minimum.
#
# THE ANSWER STAYS SHORT. One clause per area with its verdict, nothing more -
# this text is shown in the widget AND goes into the mail through errorstrings, and
# the longest check in the core (MQTT) fits in three lines. Everything with names,
# lists and numbers goes into a LoxBerry log named "Healthcheck", which the answer
# links to at the end - see the note down there for why the link has to be an
# anchor in the text and not the core's own logfile field.
#
# Runs from cron.daily with up to six hours of random offset, and 60 seconds
# after every reboot; the web interface can ask for a live run. So it has to be
# quick and cheap on a Raspberry with an SD card. Everything in here reads state
# that the services and the grabber leave behind anyway. Two things are
# deliberately NOT done:
#
#   - counting values with count(*), measured at 23.5 s for 134 measurements
#   - anything that writes to the configuration or the database
#
# Modelled on check_mqtt in sbin/healthcheck.pl, including its most useful habit:
# a service the user switched off is INFO, not an error. Only something that
# should be running and is not deserves ERROR.
#############################################################################

use warnings;
use strict;
use JSON;
use URI::Escape;
use FindBin qw($Bin);
use lib "$Bin/libs";
use LoxBerry::System;
use LoxBerry::Log;
use Globals;

my $action = $ARGV[0] // '';

my %response = (
	desc => 'Checks services, database, grabber and backup of Stats4Lox',
);

# The core asks for the description alone to build its list
if( $action ne 'check' ) {
	print encode_json( \%response );
	exit 0;
}

# The detail goes into a proper LoxBerry log, not a file written by hand: it gets
# the usual header, timestamps and levels, the viewer colours it by level, and it is
# registered in the log database - which is what lets the link below find it by name
# instead of by path.
my $log = LoxBerry::Log->new(
	name     => 'Healthcheck',
	addtime  => 1,
	loglevel => 7,
);
LOGSTART "Healthcheck";

my @summary;   # short, one entry per area - this is what the user reads

# The worst status wins, exactly as in the core
sub setstatus
{
	my ($new) = @_;
	$response{status} = $new if( !defined $response{status} or $new < $response{status} );
	return $new;
}

sub statusword
{
	my ($s) = @_;
	return $s == 3 ? 'ERROR' : $s == 4 ? 'WARNING' : $s == 5 ? 'OK' : 'INFO';
}

# LoxBerry::Log opens its file without an encoding layer and therefore writes bytes.
# The block and measurement names arrive here as CHARACTERS - they come out of
# decode_json - and handing those over unchanged turned "Mähzeit" into "M?hzeit" in
# the log. Encoded only when the string actually carries characters: a byte string
# from a backtick call would be mangled the other way by encoding it again.
sub logsafe
{
	my ($s) = @_;
	return $s if( !defined $s );
	require Encode;
	return Encode::is_utf8($s) ? Encode::encode( 'UTF-8', $s ) : $s;
}

# One area, one verdict, one short clause - and the same verdict into the log at the
# matching level, so it is colour-coded there.
sub area
{
	my ($label, $status, $short) = @_;
	setstatus( $status );
	my $line = "$label: " . statusword($status) . ( ( defined $short and $short ne '' ) ? " ($short)" : "" );
	push @summary, $line;
	my $l = logsafe( $line );
	$status == 3 ? $log->ERR( $l )
	  : $status == 4 ? $log->WARN( $l )
	  : $status == 5 ? $log->OK( $l )
	  :                $log->INF( $l );
}

sub detail { $log->INF( logsafe( join( '', @_ ) ) ) }

sub sec2human
{
	my ($s) = @_;
	return "unknown" if( !defined $s );
	return sprintf( "%d min", int($s/60) ) if( $s <  7200 );
	return sprintf( "%.1f h", $s/3600 )    if( $s < 172800 );
	return sprintf( "%.0f days", $s/86400 );
}

#############################################################################
# Services
#############################################################################
# pgrep on the binary, the same way the plugin's own service display does it -
# systemctl would be one fork per service and says less: influxd can be active
# according to systemd while the process is stuck.

{
	my (@down, @up);
	my %procs = (
		'InfluxDB' => '/usr/bin/influxd',
		'Telegraf' => '/usr/bin/telegraf',
		'Grafana'  => '/usr/share/grafana/bin/grafana',
	);
	foreach my $name ( sort keys %procs ) {
		my $pid = `pgrep -f $procs{$name} 2>/dev/null`;
		chomp $pid;
		$pid =~ s/\s+.*//s;
		if( $pid ) { push @up, "$name (PID $pid)" } else { push @down, $name }
	}

	# mqttlive is the plugin's own and can be switched off on purpose
	my $mqttoff = 0;
	if( is_disabled( $Globals::stats4lox->{mqttlive_active} ) ) {
		$mqttoff = 1;
	}
	else {
		my $pid = `pgrep -f mqttlive.php 2>/dev/null`;
		chomp $pid;
		$pid =~ s/\s+.*//s;
		if( $pid ) { push @up, "MQTT Live (PID $pid)" } else { push @down, 'MQTT Live' }
	}

	detail( "Services" );
	detail( "  running: ", join( ", ", @up ) ) if( @up );
	detail( "  NOT running: ", join( ", ", @down ) ) if( @down );
	detail( "  MQTT Live is switched off in the settings" ) if( $mqttoff );

	if( @down ) { area( 'Services', 3, join( ", ", @down ) . " not running" ) }
	else        { area( 'Services', 5, $mqttoff ? "MQTT Live off" : undef ) }
}

#############################################################################
# Database
#############################################################################

my $influx_ok = 0;
{
	my $url = $Globals::influx->{influxurl} // 'https://localhost:8086';

	# /ping needs the credentials here. It is open on a stock InfluxDB, but with
	# auth-enabled and this configuration it answers 401 without them and 204 with -
	# measured.
	my ($user, $pass) = ('', '');
	eval {
		require LoxBerry::JSON;
		my $cobj = LoxBerry::JSON->new();
		my $cred = $cobj->open( filename => $Globals::stats4loxcredentials, readonly => 1 );
		$user = $cred->{influx}->{influxdbuser} // '';
		$pass = $cred->{influx}->{influxdbpass} // '';
	};
	my $auth = ( $user ne '' ) ? "-u '$user:$pass'" : '';

	# -k because the certificate is self-signed, and a short timeout because a
	# hanging database must not hang the healthcheck.
	my $code = `curl -s -k -o /dev/null -m 5 $auth -w '%{http_code}' '$url/ping' 2>/dev/null`;
	chomp $code;

	detail( "" );
	detail( "Database" );
	detail( "  URL: $url" );

	if( $code !~ /^20/ ) {
		detail( "  /ping answered HTTP $code" );
		area( 'Database', 3, "no answer, HTTP $code" );
	}
	else {
		$influx_ok = 1;
		detail( "  /ping answered HTTP $code" );

		my ($dbstatus, $dbshort) = (5, '');

		# One cheap query that proves the credentials AND reports the retention
		# policies in passing.
		my $res = eval { require InfluxInfo; InfluxInfo::query( "SHOW RETENTION POLICIES" ) };
		if( !$res or ref($res) ne 'ARRAY' or !@$res or $res->[0]->{error} ) {
			my $msg = ( ref($res) eq 'ARRAY' and @$res and $res->[0]->{error} )
			        ? $res->[0]->{error} : 'no answer';
			detail( "  query failed: $msg" );
			detail( "  The stored password may no longer match - see the System tab." );
			$dbstatus = 3;
			$dbshort  = "query failed";
		}
		else {
			my @pol;
			foreach my $s ( @{ $res->[0]->{series} || [] } ) {
				my @cols = @{ $s->{columns} || [] };
				my ($ni) = grep { $cols[$_] eq 'name' }     0..$#cols;
				my ($di) = grep { $cols[$_] eq 'duration' } 0..$#cols;
				next if( !defined $ni );
				foreach my $v ( @{ $s->{values} || [] } ) {
					my $dur = ( defined $di and defined $v->[$di] ) ? $v->[$di] : '?';
					push @pol, $v->[$ni] . " ($dur)";
				}
			}
			detail( "  retention policies: " . ( @pol ? join( ", ", @pol ) : "none" ) );
		}

		# How large the database is, and how much room is left where it lives.
		#
		# The size comes from InfluxDB itself, not from du: the data directory belongs
		# to the influxdb user, and du run as loxberry stops at "Permission denied" on
		# wal/ and reports 48 KB for a 758 MB database. SHOW STATS has the exact figure
		# per shard and needs no permissions at all.
		my $datadir = "$LoxBerry::System::lbpdatadir/influxdb";
		if( -d $datadir ) {
			my $df = `df -Pk '$datadir' 2>/dev/null | tail -1`;
			my @f = split( /\s+/, ( $df // '' ) );
			if( @f >= 5 ) {
				my $freemb = int( $f[3] / 1024 );
				my $usepct = $f[4];
				$usepct =~ s/%//;

				my ($bytes, $shards) = (0, 0);
				eval {
					require InfluxInfo;
					my $st = InfluxInfo::query( "SHOW STATS" );
					foreach my $r ( @$st ) {
						foreach my $s ( @{ $r->{series} || [] } ) {
							next if( ($s->{name} // '') ne 'tsm1_filestore' );
							my @cols = @{ $s->{columns} || [] };
							my ($di) = grep { $cols[$_] eq 'diskBytes' } 0..$#cols;
							next if( !defined $di );
							foreach my $v ( @{ $s->{values} || [] } ) {
								$bytes += ( $v->[$di] // 0 );
								$shards++;
							}
						}
					}
				};

				detail( "  directory: $datadir" );
				detail( sprintf( "  size: %s", $shards ? sprintf( "%.0f MB in %d shards", $bytes/1048576, $shards ) : "could not be determined" ) );
				detail( sprintf( "  free on its partition: %d MB (%d%% used)", $freemb, $usepct ) );

				my $sizetxt = $shards ? sprintf( "%.0f MB", $bytes/1048576 ) : "size unknown";
				if( $usepct >= 95 or $freemb < 200 ) {
					detail( "  Almost no space left - the database will stop writing." );
					$dbstatus = 3 if( $dbstatus > 3 );
					$dbshort  = sprintf( "only %d MB free", $freemb );
				}
				elsif( $usepct >= 90 or $freemb < 500 ) {
					detail( "  Space is getting tight." );
					$dbstatus = 4 if( $dbstatus > 4 );
					$dbshort  = sprintf( "only %d MB free", $freemb );
				}
				elsif( $dbshort eq '' ) {
					$dbshort = sprintf( "%s, %.1f GB free", $sizetxt, $freemb/1024 );
				}
			}
		}

		area( 'Database', $dbstatus, $dbshort );
	}
}

#############################################################################
# Grabber
#############################################################################
# The grabber records its failures in stats.json, so the state is already there
# and nothing has to be asked of the Miniserver. 404 means the block is gone from
# the Loxone configuration, a timeout means it did not answer; after ten failures
# the grabber stops asking, and from then on no data arrives at all without
# anybody noticing - that is what deserves an ERROR.

my $statsjson;
{
	# Read by hand rather than through LoxBerry::JSON, for two reasons.
	#
	# The measurement names are compared against what InfluxDB returns further
	# down, and that comes out of decode_json as CHARACTERS. LoxBerry::JSON hands
	# back byte strings, so "Wärme" would never match "Wärme" - issue #128 all over
	# again.
	#
	# And a shared lock is still wanted: LoxBerry::JSON::write() writes in place
	# with seek and truncate, so an unlocked reader can catch a half-written file.
	# Non-blocking with a few short retries - this check must never be the reason a
	# web request has to wait.
	require Fcntl;
	if( open( my $fh, '<:raw', $Globals::statsconfig ) ) {
		my $got = 0;
		foreach ( 1 .. 6 ) {
			last if( $got = flock( $fh, Fcntl::LOCK_SH() | Fcntl::LOCK_NB() ) );
			select( undef, undef, undef, 0.5 );
		}
		if( $got ) {
			local $/;
			my $raw = <$fh>;
			flock( $fh, Fcntl::LOCK_UN() );
			$statsjson = eval { decode_json( $raw ) };
		}
		close $fh;
	}

	detail( "" );
	detail( "Grabber" );

	# Is it running at all? Telegraf polls its CGI every 60 seconds.
	#
	# The age comes from the memory file the grabber keeps in the ramdisk, not from
	# its log. The log is not dependable for this: it lives in log/plugins, which the
	# core tidies up with log_maint.pl, and it was observed to be missing for a
	# moment between two runs - which had this check announce that the grabber had
	# never run while it was running fine. The memory file is written on every single
	# cycle and nothing else touches it. Its path is the one the grabber hardcodes;
	# if that changes, this has to follow.
	my $age;
	foreach my $f ( "/dev/shm/stats4lox_mem_loxonegrabber.json",
	                "$LoxBerry::System::lbplogdir/grabber_loxone.log" ) {
		next if( ! -f $f );
		my $a = time() - ( stat($f) )[9];
		$age = $a if( !defined $age or $a < $age );
	}

	my ($status, @short) = (5);

	if( !defined $age ) {
		# Deliberately not "never ran": the marker is in a ramdisk and gone after a
		# reboot, so right after one this is the normal state for up to a minute.
		detail( "  no sign of a run - is Telegraf calling the grabber?" );
		$status = 4;
		push @short, "no sign of a run";
	}
	else {
		detail( "  last run: " . sec2human($age) . " ago" );
		if( $age > 900 ) {
			detail( "  Telegraf calls it every 60 seconds, so it is not being called." );
			$status = 3;
			push @short, "last run " . sec2human($age) . " ago";
		}
		elsif( $age > 300 ) {
			$status = 4 if( $status > 4 );
			push @short, "last run " . sec2human($age) . " ago";
		}
	}

	if( !$statsjson or ref($statsjson->{loxone}) ne 'ARRAY' ) {
		detail( "  stats.json could not be read (locked or broken) - statistics not checked" );
		$status = 4 if( $status > 4 );
		push @short, "stats.json unreadable";
	}
	else {
		my @entries = @{ $statsjson->{loxone} };
		my $active  = grep { is_enabled( $_->{active} ) } @entries;

		my (@gone, @timeout, @givenup);
		foreach my $e ( @entries ) {
			my $st = $e->{status} or next;
			next if( !$st->{error} );
			my $name = $e->{name} // '?';
			if( ( $st->{count} // 0 ) >= 10 ) { push @givenup, $name; next }
			if( $st->{error} eq '404' )       { push @gone, $name }
			else                              { push @timeout, $name }
		}

		detail( sprintf( "  %d statistics configured, %d active", scalar @entries, $active ) );

		if( @givenup ) {
			detail( sprintf( "  GIVEN UP on %d after ten failed attempts - no data arrives for these any more:", scalar @givenup ) );
			detail( "    $_" ) foreach @givenup;
			detail( "  Remove them under 'Loxone and Import', or restore the block in Loxone Config." );
			$status = 3;
			push @short, scalar(@givenup) . " given up";
		}
		if( @gone ) {
			detail( sprintf( "  %d whose block the Miniserver does not know (error 404):", scalar @gone ) );
			detail( "    $_" ) foreach @gone;
			$status = 4 if( $status > 4 );
			push @short, scalar(@gone) . " unknown to the Miniserver";
		}
		if( @timeout ) {
			detail( sprintf( "  %d not answering:", scalar @timeout ) );
			detail( "    $_" ) foreach @timeout;
			$status = 4 if( $status > 4 );
			push @short, scalar(@timeout) . " not answering";
		}
		push @short, "$active active" if( $status == 5 );
	}

	area( 'Grabber', $status, join( ", ", @short ) );
}

#############################################################################
# Measurements without an owner
#############################################################################
# They keep taking space and nobody goes looking for them.
#
# The definition is taken from the InfluxDB page, statusOf() in influx.js, so the
# two cannot disagree: no entry in stats.json, not one of our own system
# measurements, not from the MQTT collector, written by the grabber, has a uuid
# tag, and none of its uuids is in the Loxone configuration we read in.
#
# Only SHOW queries, measured at about 0.2 s each - no count(*).

if( $influx_ok and $statsjson and ref($statsjson->{loxone}) eq 'ARRAY' ) {
	my $orphans = eval {
		require InfluxInfo;
		my $measurements = InfluxInfo::measurements();
		my $srcs         = InfluxInfo::sources();
		my $tags         = InfluxInfo::uuids();
		my $system       = InfluxInfo::system_measurements();
		my $plan         = InfluxInfo::loxplan_uuids();
		my %planlc = map { lc($_) => 1 } keys %$plan;

		my %configured = map { $_->{measurementname} => 1 }
		                 grep { defined $_->{measurementname} and $_->{measurementname} ne '' }
		                 @{ $statsjson->{loxone} };

		my @o;
		foreach my $m ( @$measurements ) {
			next if( $configured{$m} );
			next if( $system->{$m} );
			my @s = @{ $srcs->{$m} // [] };
			next if( grep { $_ eq 'mqtt' } @s );
			next if( !grep { $_ eq 'grabber' } @s );
			my @u = grep { defined } @{ $tags->{$m} // [] };
			next if( !@u );
			next if( grep { $planlc{ lc $_ } } @u );
			push @o, $m;
		}
		\@o;
	};

	detail( "" );
	detail( "Measurements" );

	if( $@ or ref($orphans) ne 'ARRAY' ) {
		detail( "  could not be determined" );
		area( 'Measurements', 6, "not determined" );
	}
	elsif( @$orphans ) {
		detail( sprintf( "  %d belong to no statistic and to no block in Loxone Config:", scalar @$orphans ) );
		detail( "    $_" ) foreach @$orphans;
		detail( "  They can be removed on the InfluxDB page." );
		area( 'Measurements', 4, scalar(@$orphans) . " orphaned" );
	}
	else {
		detail( "  none orphaned" );
		area( 'Measurements', 5 );
	}
}

#############################################################################
# Diagnostic logging of the services
#############################################################################
# Off by default: it makes InfluxDB, Telegraf and Grafana write into
# log/plugins/stats4lox/, which is a ramdisk on LoxBerry, and that is what issue
# #134 was about. It is meant for hunting a problem and to be switched off again.
# Switching it off automatically is expressly not wanted - so this only points at
# it.

{
	detail( "" );
	detail( "Diagnostic logging of the services" );

	if( is_enabled( $Globals::stats4lox->{servicelogging} ) ) {
		my $bytes = 0;
		foreach my $f ( glob( "$LoxBerry::System::lbplogdir/*" ) ) {
			$bytes += ( -s $f ) // 0 if( -f $f );
		}
		detail( sprintf( "  switched ON, %.1f MB in %s", $bytes/1048576, $LoxBerry::System::lbplogdir ) );
		detail( "  It is meant for finding a problem. Switch it off again under Settings when you" );
		detail( "  are done - it writes to a ramdisk." );
		area( 'Service logging', 4, sprintf( "on, %.1f MB", $bytes/1048576 ) );
	}
	else {
		detail( "  off" );
		area( 'Service logging', 6, "off" );
	}
}

#############################################################################
# Backup
#############################################################################

{
	my $b = $Globals::backup;
	my $path = $b->{storagepath} // '';
	my $scheduled = is_enabled( $b->{schedule}->{active} );

	detail( "" );
	detail( "Backup" );
	detail( "  scheduled: " . ( $scheduled ? "yes" : "no" ) );

	if( !$path ) {
		detail( "  no storage path configured" );
		area( 'Backup', 6, "not configured" );
	}
	elsif( ! -d $path ) {
		detail( "  the configured directory does not exist: $path" );
		area( 'Backup', 3, "directory missing" );
	}
	else {
		my @archives = sort { ( stat($b) )[9] <=> ( stat($a) )[9] }
		               glob( "$path/stats4lox_*" );
		detail( "  directory: $path" );

		if( !@archives ) {
			detail( "  no backup present" );
			area( 'Backup', ( $scheduled ? 4 : 6 ), $scheduled ? "scheduled but none present" : "none present" );
		}
		else {
			my $age = time() - ( stat( $archives[0] ) )[9];
			detail( sprintf( "  %d backups, newest %s old", scalar @archives, sec2human($age) ) );
			detail( "    " . ( $_ =~ m{([^/]+)$} )[0] ) foreach @archives;
			# Only judged when it is supposed to happen by itself. A backup taken by
			# hand may be as old as the user wants it to be.
			if( $scheduled and $age > 14*86400 ) {
				detail( "  The scheduled backup is on but the newest one is older than two weeks." );
				area( 'Backup', 4, "newest " . sec2human($age) . " old" );
			}
			else {
				area( 'Backup', 5, sprintf( "%d, newest %s old", scalar @archives, sec2human($age) ) );
			}
		}
	}
}

#############################################################################
# Write the logfile and answer
#############################################################################

setstatus(6) if( !defined $response{status} );

$log->INF( "" );
$log->INF( "Overall: " . statusword( $response{status} ) );
LOGEND;

# The link to the logfile, as an anchor inside the result.
#
# The core's own "logfile" and "url" fields are not available to a plugin:
# exec_plugincheck copies exactly desc, status and result out of our answer and
# drops everything else (LoxBerry issue #1546). So the link has to travel inside
# the text - and it can, because healthcheck.html inserts the result with .html(),
# not .text():
#
#   $("#"+rowname+"result").html(element.result);
#
# which is why a bare URL came out as unclickable text and an anchor does not.
#
# Addressed by package and name, not by path: LoxBerry::Log registered this run in
# the log database, and logfile.cgi looks the newest entry up from there. So the
# link keeps working although every run writes a new file, and there is no path to
# get wrong.
#
# only=once because this log is not being written while it is read. Without it the
# viewer polls the file every 300 ms and scrolls along, which is what you want for a
# running service and pointless for a report that is already finished.
#
# Absolute, because the same text goes into the notification: healthcheck.pl puts
# the result of every failing check into errorstrings, and there a relative path is
# worthless. Host and port come from the library, the way GrafanaS4L builds the
# dashboard link; lbhostname can be empty, then the IP has to do, and port 80 is
# left off because it only makes the link longer.
my $host = LoxBerry::System::lbhostname();
$host = LoxBerry::System::get_localip() if( !$host );
my $port = LoxBerry::System::lbwebserverport();
my $pkg  = $LoxBerry::System::lbpplugindir || 'stats4lox';
my $logurl = "http://$host" . ( ( $port and $port != 80 ) ? ":$port" : "" )
           . "/admin/system/tools/logfile.cgi"
           . "?package=" . uri_escape($pkg)
           . "&amp;name=Healthcheck"
           . "&amp;header=html&amp;format=template&amp;only=once";

$response{result} = join( " ", map { "$_." } @summary )
                  . qq{ <a href="$logurl" target="_blank">Logfile</a>};

print encode_json( \%response );
exit 0;
